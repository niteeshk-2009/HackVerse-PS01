# ==============================================================================
# SPIDER SENSE — Environment Configuration
# ==============================================================================

# Application Server
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=production

# Data Provider Mode: 'DEMO' or 'LIVE'
# In 'DEMO' mode, deterministic NSE data is used without external API dependencies.
# In 'LIVE' mode, live exchange adapters are activated.
DATA_MODE=DEMO

# Live Exchange Feed Credentials (Optional - Required only if DATA_MODE=LIVE)
NSE_API_KEY=
NSE_API_SECRET=
YAHOO_FINANCE_ENABLED=false

# Persistence & Telemetry
DATABASE_PATH=telemetry_sessions.db
LOG_LEVEL=INFO
