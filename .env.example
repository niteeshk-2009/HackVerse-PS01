# ==============================================================================
# SPIDER SENSE — Environment Configuration
# ==============================================================================
# ZERO SECRETS REQUIRED: In default DEMO mode, Spider Sense runs 100% autonomously
# with deterministic NSE/NASDAQ data, SEC/SEBI RAG filings, and full multi-agent
# synthesis without requiring any paid API keys or external secrets.

# ------------------------------------------------------------------------------
# 1. SERVER CONFIGURATION [OPTIONAL - Defaults to 0.0.0.0:8000]
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=production

# ------------------------------------------------------------------------------
# 2. DATA MODE [OPTIONAL - Defaults to DEMO]
# ------------------------------------------------------------------------------
# Options: 'DEMO' (deterministic, verifiable simulation) or 'LIVE' (real exchange)
DATA_MODE=DEMO

# ------------------------------------------------------------------------------
# 3. LIVE EXCHANGE CREDENTIALS [OPTIONAL - Only used if DATA_MODE=LIVE]
# ------------------------------------------------------------------------------
# If left blank, Spider Sense operates truthfully in DEMO mode with clear UI tags.
NSE_API_KEY=
NSE_API_SECRET=
YAHOO_FINANCE_ENABLED=false

# ------------------------------------------------------------------------------
# 4. TELEMETRY & LOGGING [OPTIONAL]
# ------------------------------------------------------------------------------
DATABASE_PATH=telemetry_sessions.db
LOG_LEVEL=INFO
